{
  "$description": "Reli design tokens. Single source of truth: edit this file, then run `npm run tokens`.",
  "primitive": {
    "color": {
      "popcorn":  { "$type": "color", "$value": "#FFFDF7", "$description": "Pochoclo. Lightest surface." },
      "cream":    { "$type": "color", "$value": "#FBF4E6", "$description": "Crema. Light page background." },
      "cream-2":  { "$type": "color", "$value": "#F3E7D0" },
      "cream-3":  { "$type": "color", "$value": "#E6D5B8" },
      "butter":   { "$type": "color", "$value": "#F6CF6A", "$description": "Manteca. Accent on dark." },
      "butter-2": { "$type": "color", "$value": "#FADF97" },
      "bucket":   { "$type": "color", "$value": "#D7322F", "$description": "Rojo balde. Brand red." },
      "bucket-2": { "$type": "color", "$value": "#B8292A" },
      "bucket-3": { "$type": "color", "$value": "#9C2026" },
      "seat":     { "$type": "color", "$value": "#8E1F2B", "$description": "Butaca. Deep red." },
      "seat-light": { "$type": "color", "$value": "#FF8F86" },
      "caramel":  { "$type": "color", "$value": "#C68A4E", "$description": "Caramelo. Decorative only, never text on cream." },
      "caramel-2": { "$type": "color", "$value": "#8A5A2B" },
      "ink":      { "$type": "color", "$value": "#3A2A22", "$description": "Tinta. Main text on light. Replaces pure black." },
      "ink-2":    { "$type": "color", "$value": "#6B5649" },
      "ink-3":    { "$type": "color", "$value": "#8A7465" },
      "night":    { "$type": "color", "$value": "#1E1714", "$description": "Función de noche. Dark page background." },
      "night-2":  { "$type": "color", "$value": "#2A211C" },
      "night-3":  { "$type": "color", "$value": "#372B24" },
      "night-4":  { "$type": "color", "$value": "#4A3B32" },
      "smoke":    { "$type": "color", "$value": "#F5EDE0", "$description": "Main text on dark. Replaces pure white." },
      "smoke-2":  { "$type": "color", "$value": "#CDBFAE" },
      "smoke-3":  { "$type": "color", "$value": "#9C8B7B" },
      "green":    { "$type": "color", "$value": "#2E7D4F" },
      "green-light": { "$type": "color", "$value": "#7FD3A0" }
    }
  },
  "theme": {
    "light": {
      "$description": "Pochoclo (light)",
      "color": {
        "bg":              { "$type": "color", "$value": "{primitive.color.cream}" },
        "surface":         { "$type": "color", "$value": "{primitive.color.popcorn}" },
        "surface-sunken":  { "$type": "color", "$value": "{primitive.color.cream-2}" },
        "surface-selected":{ "$type": "color", "$value": "{primitive.color.ink}" },
        "border":          { "$type": "color", "$value": "{primitive.color.cream-3}", "$description": "Decorative dividers only. Not for controls." },
        "border-control":  { "$type": "color", "$value": "{primitive.color.ink-3}", "$description": "Inputs, chips, outlined buttons. 3:1 or more." },
        "text":            { "$type": "color", "$value": "{primitive.color.ink}" },
        "text-muted":      { "$type": "color", "$value": "{primitive.color.ink-2}" },
        "text-on-selected":{ "$type": "color", "$value": "{primitive.color.popcorn}" },
        "primary":         { "$type": "color", "$value": "{primitive.color.bucket}" },
        "primary-hover":   { "$type": "color", "$value": "{primitive.color.bucket-2}" },
        "primary-pressed": { "$type": "color", "$value": "{primitive.color.bucket-3}" },
        "text-on-primary": { "$type": "color", "$value": "#FFFFFF" },
        "link":            { "$type": "color", "$value": "{primitive.color.seat}" },
        "focus":           { "$type": "color", "$value": "{primitive.color.seat}" },
        "accent":          { "$type": "color", "$value": "{primitive.color.butter}", "$description": "Highlights behind dark text. Never as text." },
        "text-on-accent":  { "$type": "color", "$value": "{primitive.color.ink}" },
        "progress":        { "$type": "color", "$value": "{primitive.color.bucket}" },
        "progress-track":  { "$type": "color", "$value": "{primitive.color.cream-3}" },
        "success":         { "$type": "color", "$value": "{primitive.color.green}" },
        "danger":          { "$type": "color", "$value": "{primitive.color.seat}" }
      }
    },
    "dark": {
      "$description": "Función de noche (dark)",
      "color": {
        "bg":              { "$type": "color", "$value": "{primitive.color.night}" },
        "surface":         { "$type": "color", "$value": "{primitive.color.night-2}" },
        "surface-sunken":  { "$type": "color", "$value": "#181210" },
        "surface-selected":{ "$type": "color", "$value": "{primitive.color.smoke}" },
        "border":          { "$type": "color", "$value": "{primitive.color.night-4}", "$description": "Decorative dividers only. Not for controls." },
        "border-control":  { "$type": "color", "$value": "{primitive.color.smoke-3}", "$description": "Inputs, chips, outlined buttons. 3:1 or more." },
        "text":            { "$type": "color", "$value": "{primitive.color.smoke}" },
        "text-muted":      { "$type": "color", "$value": "{primitive.color.smoke-2}" },
        "text-on-selected":{ "$type": "color", "$value": "{primitive.color.night}" },
        "primary":         { "$type": "color", "$value": "{primitive.color.butter}" },
        "primary-hover":   { "$type": "color", "$value": "{primitive.color.butter-2}" },
        "primary-pressed": { "$type": "color", "$value": "#E4B94E" },
        "text-on-primary": { "$type": "color", "$value": "{primitive.color.ink}" },
        "link":            { "$type": "color", "$value": "{primitive.color.butter}" },
        "focus":           { "$type": "color", "$value": "{primitive.color.butter}" },
        "accent":          { "$type": "color", "$value": "{primitive.color.butter}", "$description": "Highlights behind dark text." },
        "text-on-accent":  { "$type": "color", "$value": "{primitive.color.ink}" },
        "progress":        { "$type": "color", "$value": "{primitive.color.butter}" },
        "progress-track":  { "$type": "color", "$value": "{primitive.color.night-4}" },
        "success":         { "$type": "color", "$value": "{primitive.color.green-light}" },
        "danger":          { "$type": "color", "$value": "{primitive.color.seat-light}" }
      }
    }
  },
  "font": {
    "family": {
"base": { "$type": "fontFamily", "$value": "'Rubik', system-ui, -apple-system, 'Segoe UI', sans-serif", "$description": "The only font, for UI and Reli's voice. Tall x-height, rounded corners." }
    },
    "weight": {
      "regular": { "$type": "fontWeight", "$value": 400 },
      "bold":    { "$type": "fontWeight", "$value": 700 }
    },
    "size": {
      "caption": { "$type": "dimension", "$value": "13px", "$description": "Metadata. Minimum size in the app." },
      "small":   { "$type": "dimension", "$value": "14px" },
      "body":    { "$type": "dimension", "$value": "16px", "$description": "Default text and every input (avoids iOS zoom)." },
      "title-sm":{ "$type": "dimension", "$value": "18px" },
      "title":   { "$type": "dimension", "$value": "22px" },
      "display": { "$type": "dimension", "$value": "28px" }
    },
    "line-height": {
      "tight": { "$type": "number", "$value": 1.25, "$description": "Headings and one-line labels." },
      "base":  { "$type": "number", "$value": 1.5,  "$description": "UI text." },
      "long":  { "$type": "number", "$value": 1.65, "$description": "Comments, synopsis, any paragraph." }
    }
  },
  "space": {
    "0":  { "$type": "dimension", "$value": "0px" },
    "1":  { "$type": "dimension", "$value": "4px" },
    "2":  { "$type": "dimension", "$value": "8px" },
    "3":  { "$type": "dimension", "$value": "12px" },
    "4":  { "$type": "dimension", "$value": "16px" },
    "5":  { "$type": "dimension", "$value": "24px" },
    "6":  { "$type": "dimension", "$value": "32px" },
    "7":  { "$type": "dimension", "$value": "48px" },
    "8":  { "$type": "dimension", "$value": "64px" }
  },
  "size": {
    "touch":     { "$type": "dimension", "$value": "44px", "$description": "Minimum tap target." },
    "control":   { "$type": "dimension", "$value": "48px", "$description": "Default height for buttons and inputs." },
    "control-lg":{ "$type": "dimension", "$value": "52px" }
  },
  "radius": {
    "sm":   { "$type": "dimension", "$value": "8px" },
    "md":   { "$type": "dimension", "$value": "12px" },
    "lg":   { "$type": "dimension", "$value": "16px" },
    "xl":   { "$type": "dimension", "$value": "24px" },
    "pill": { "$type": "dimension", "$value": "999px" }
  },
  "border": {
    "width": { "$type": "dimension", "$value": "1.5px" },
    "focus": { "$type": "dimension", "$value": "3px" }
  },
  "shadow": {
    "1": { "$type": "shadow", "$value": "0 1px 2px rgb(58 42 34 / 0.08), 0 1px 1px rgb(58 42 34 / 0.04)", "$description": "Cards at rest." },
    "2": { "$type": "shadow", "$value": "0 4px 12px rgb(58 42 34 / 0.12)", "$description": "Floating: bottom nav, menus." },
    "3": { "$type": "shadow", "$value": "0 12px 32px rgb(58 42 34 / 0.18)", "$description": "Sheets and dialogs." }
  },
  "motion": {
    "duration": {
      "fast": { "$type": "duration", "$value": "120ms", "$description": "Hover, press, toggle." },
      "base": { "$type": "duration", "$value": "200ms", "$description": "Small moves, fades." },
      "slow": { "$type": "duration", "$value": "320ms", "$description": "Sheets entering the screen." }
    },
    "easing": {
      "standard": { "$type": "cubicBezier", "$value": "cubic-bezier(0.2, 0, 0, 1)" },
      "enter":    { "$type": "cubicBezier", "$value": "cubic-bezier(0, 0, 0, 1)" },
      "exit":     { "$type": "cubicBezier", "$value": "cubic-bezier(0.3, 0, 1, 1)" }
    }
  }
}
